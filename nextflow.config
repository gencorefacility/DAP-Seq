manifest {
    name            = 'dapseq'
    description     = 'DAP-seq: reads -> peaks (GEM) -> de novo motifs (MEME-ChIP), any organism'
    mainScript      = 'main.nf'
    nextflowVersion = '>=25.04'
}

params {
    // Inputs
    input          = null      // samplesheet CSV: sample,fastq_1,fastq_2,control,group
    fasta          = null      // genome FASTA (plain or .gz)
    gtf            = null      // gene models (plain or .gz), same contig names as --fasta: annotation + IGV genes
    bowtie2_index  = null      // optional dir with a prebuilt index; built from --fasta if absent
    outdir         = 'results'
    save_reference = false     // publish the built index / chromosome FASTAs to <outdir>/genome
                               // (a .gz --fasta's decompressed copy + .fai go there regardless, for the IGV session)

    // Read filtering (upstream: MAPQ 30 on Arabidopsis chromosomes 1-5). Paired-end libraries keep
    // proper pairs whose mates both pass, then read 1 only (one read per fragment; GEM would count
    // both mates): fixed, not a param.
    min_mapq         = 30
    keep_chromosomes = null    // e.g. "1,2,3,4,5"; null = all contigs. Also passed to GEM --subs

    // GEM. The defaults point inside the ch-env container (same GEM 3.3 build upstream used).
    gem_jar       = '/apps/gem/3.3/gem.jar'
    gem_read_dist = '/apps/gem/3.3/Read_Distribution_default.txt'
    gem_k_min     = 5
    gem_k_max     = 14
    gem_k_seqs    = 2000

    // Motif discovery
    top_n_peaks = 600          // peaks (ranked by qValue, signalValue) sent to MEME-ChIP
                               // only limits the MEME-ChIP input. Peak annotation, motif QC use all peaks
    peak_halfwidth = 100       // MEME-ChIP gets summit +/- this (201 bp = GEM's own event windows);
                               // its MEME and STREME steps then search the central 100 bp (its default)
    memechip_db = null         // optional known-motif DB for MEME-ChIP (-db), e.g. ArabidopsisDAPv1.meme

    // Motif QC (all peaks), in this order: --qc_motifs consensus strings (exact match, either strand),
    // every motif in the --qc_motifs MEME files (FIMO), the top qc_motifs_n_denovo of MEME-ChIP's motifs
    // (FIMO).
    qc_motifs          = null   // expected motif(s): IUPAC strings and/or MEME files, e.g. "CAGGTAG" or "CAGGTAG,zelda.meme"
    qc_motifs_n_denovo = 1      // top MEME-ChIP motifs to add; 0 = only --qc_motifs
    qc_motifs_pvalue   = 1e-4   // FIMO match threshold (matrices only)

    // bigWigs for genome browser
    bigwig_extend    = 200     // single-end only: extend reads to this length in bp (0 = don't extend);
                               // 200 = the hlab1 demo's value. Paired-end always uses the mates' real
                               // fragment, so this number is ignored for paired-end reads.
    bigwig_bin_size  = 1
    bigwig_normalize = 'RPKM'  // bamCoverage --normalizeUsing: RPKM, CPM, BPM, RPGC or None

    // Extra command-line arguments, appended verbatim
    trim_args     = ''
    bowtie2_args  = ''
    gem_args      = ''
    memechip_args = ''
    bigwig_args   = ''
}

process {
    shell         = ['/bin/bash', '-euo', 'pipefail']
    cpus          = 1
    memory        = { 4.GB * task.attempt }
    time          = { 4.h * task.attempt }
    errorStrategy = { task.exitStatus in [137, 140, 143] ? 'retry' : 'finish' }  // OOM / time limit
    maxRetries    = 2

    // Tool versions match genericdata/ch-env (what upstream ran) so the first comparison
    // against upstream differs only in pipeline logic. Bump once parity is confirmed.
    // Biocontainers as prebuilt Singularity images from the Galaxy depot (quay.io pulls were flaky
    // and need OCI->SIF conversion); Docker equivalent: quay.io/biocontainers/<same name:tag>.
    withName: 'PREP_GENOME|SORT_FILTER_BAM|PEAK_QC' {
        container = 'https://depot.galaxyproject.org/singularity/samtools:1.11--h6270b1f_0'
    }
    withName: 'SORT_FILTER_BAM' {
        cpus   = 4
        memory = { 8.GB * task.attempt }
    }
    withName: 'BOWTIE2_BUILD' {
        container = 'https://depot.galaxyproject.org/singularity/bowtie2:2.4.2--py38hc2f83ea_2'
        cpus      = 8
        memory    = { 16.GB * task.attempt }
        time      = { 8.h * task.attempt }
    }
    withName: 'TRIM_GALORE' {
        container = 'https://depot.galaxyproject.org/singularity/trim-galore:0.6.6--hdfd78af_1'
        cpus      = 4
        memory    = { 8.GB * task.attempt }
    }
    withName: 'BOWTIE2_ALIGN' {
        container = 'https://depot.galaxyproject.org/singularity/bowtie2:2.4.2--py38hc2f83ea_2'
        cpus      = 8
        memory    = { 16.GB * task.attempt }
        time      = { 8.h * task.attempt }
    }
    // GEM isn't on Bioconda; run it from upstream's all-in-one image (GEM 3.3 + JDK 8), pinned
    // by digest since the image only has a `latest` tag.
    withName: 'GEM' {
        container     = 'genericdata/ch-env@sha256:815ea620f4a1a18a2bf137ed1231253f7ea10f3d6da2fe25550e1c3c1d25a76b'
        cpus          = 1          // GEM runs with --t 1: more threads aren't reproducible
        memory        = { 32.GB * task.attempt }
        time          = { 24.h * task.attempt }
        errorStrategy = { task.exitStatus in [3, 137, 140, 143] ? 'retry' : 'finish' }  // 3 = Java heap
    }
    withName: 'GEM_QC' {
        container = 'genericdata/ch-env@sha256:815ea620f4a1a18a2bf137ed1231253f7ea10f3d6da2fe25550e1c3c1d25a76b'   // python3
    }
    withName: 'TOP_PEAKS_FASTA' {
        container = 'https://depot.galaxyproject.org/singularity/bedtools:2.29.2--hc088bd4_0'
    }
    // HOMER 5.1 build _0: the newer pl5321hc52dbad_1 build lacks libstdc++ for assignGenomeAnnotation
    // (every peak's annotation comes out NA, exit 0; ANNOTATE_PEAKS now fails on that).
    withName: 'ANNOTATE_PEAKS' {
        container = 'https://depot.galaxyproject.org/singularity/homer:5.1--pl5262h9948957_0'
        memory    = { 8.GB * task.attempt }
    }
    withName: 'BIGWIG' {
        container = 'https://depot.galaxyproject.org/singularity/deeptools:3.5.0--py_0'   // upstream's module version
        cpus      = 4
        memory    = { 8.GB * task.attempt }
    }
    withName: 'IGV_SESSION' {
        executor = 'local'   // writes one small XML file: no container, no SLURM job
    }
    withName: 'MULTIQC' {
        container = 'https://depot.galaxyproject.org/singularity/multiqc:1.35--pyhdfd78af_1'
    }
    // MEME-ChIP from ch-env too (upstream's exact MEME 5.3.0) for the 1:1 validation: Bioconda's
    // MEME has a broken CentriMo/SpaMo on this cluster. Official memesuite/memesuite images work;
    // candidate replacement once validated. MOTIF_QC needs only MEME tools (fimo,
    // fasta-shuffle-letters) + python3, which memesuite/memesuite:5.5.9 also has, so moving both
    // is just this container line.
    withName: 'MEME_CHIP|MOTIF_QC' {
        container = 'genericdata/ch-env@sha256:815ea620f4a1a18a2bf137ed1231253f7ea10f3d6da2fe25550e1c3c1d25a76b'
        memory    = { 8.GB * task.attempt }
        time      = { 12.h * task.attempt }
    }
}

profiles {
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }
    // SLURM. Before launching, set SBATCH_ACCOUNT if your cluster requires an account, and
    // NXF_SINGULARITY_CACHEDIR so images are pulled once.
    slurm {
        process.executor       = 'slurm'
        process.clusterOptions = '--export=NONE'
    }
}

timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/report.html"
}
trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/trace.tsv"
}
